{
  "openapi": "3.1.0",
  "info": {
    "title": "NTH Arcade API",
    "version": "1.0.0",
    "description": "Public, read-only catalog of the browser games on NTH Arcade. No authentication required."
  },
  "servers": [{ "url": "https://nth-arcade.vercel.app" }],
  "paths": {
    "/api/games": {
      "get": {
        "operationId": "listGames",
        "summary": "List games",
        "description": "Returns every game on NTH Arcade with its description, controls and play URL.",
        "responses": {
          "200": {
            "description": "All games.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "games": { "type": "array", "items": { "$ref": "#/components/schemas/Game" } }
                  },
                  "required": ["games"]
                }
              }
            }
          },
          "405": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/games/{id}": {
      "get": {
        "operationId": "getGame",
        "summary": "Get a game",
        "description": "Returns one game by id, including its controls and play URL.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Game id.",
            "schema": {
              "type": "string",
              "enum": ["2048", "snake", "minesweeper", "flappy-bird", "dino", "tetris", "gomoku"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The game.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Game" } }
            }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "405": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "Structured JSON error.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    },
    "schemas": {
      "Game": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "Stable game id." },
          "name": { "type": "string", "description": "Display name." },
          "path": { "type": "string", "description": "Site path of the game." },
          "description": { "type": "string", "description": "What the game is about." },
          "controls": { "type": "string", "description": "Input controls." },
          "url": { "type": "string", "format": "uri", "description": "Absolute play URL." }
        },
        "required": ["id", "name", "path", "description", "controls", "url"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "description": "Stable machine-readable error code." },
              "message": { "type": "string", "description": "What went wrong." },
              "hint": { "type": "string", "description": "How to fix the request." }
            },
            "required": ["code", "message", "hint"]
          }
        },
        "required": ["error"]
      }
    }
  }
}
